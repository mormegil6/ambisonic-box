# docker-compose.override.yml: deployment-specific settings (EXAMPLE).
#
# Copy to `docker-compose.override.yml` on the deployment host; Compose loads it
# automatically on top of docker-compose.yml, and it is gitignored. Nothing here
# is required; the base stack runs standalone. These are production niceties for
# a Linux host; adjust paths/IPs to yours.

services:

  telemetry:
    environment:
      - TEL_HOST=my-stream-box          # name shown on the dashboard + in alerts
      # Telegram breakage alerts (optional). Prefer putting these in .env (also
      # gitignored) so they are not duplicated across services:
      # - BOT_TOKEN=123456:AA...
      # - CHAT_ID=987654321
    volumes:
      # Linux host metrics (optional; absent -> those fields simply read null).
      # CPU temp needs NO mount: the container already sees the host sysfs, so the
      # collector reads /sys/class/thermal/thermal_zone0/temp directly (bind-
      # mounting /sys/class/thermal would only give a dangling symlink).
      - /:/host/root:ro                        # disk usage of the HOST root (df /)
      - /proc/uptime:/host/uptime:ro           # host uptime (not the container's)
      # Deployment favicon for the dashboard, from the same brand.json the player
      # uses. Optional, and commented out because `custom/` is gitignored: a
      # fresh clone has no such file, and compose creates a DIRECTORY in its
      # place, which the reader then has to debug. Copy
      # services/hoast-player/brand.example.json to custom/brand.json first,
      # then uncomment this and its twin under hoast-player.
      #- ./custom/brand.json:/app/brand.json:ro
    ports:
      # Expose the PRIVATE dashboard only on the Tailscale interface, never
      # publish :8090 to 0.0.0.0. Replace with this host's 100.x Tailscale IP:
      - "100.64.0.1:8090:8090"

  hoast-player:
    volumes:
      # Deployment branding: the committed page is generic; this mounts a small
      # brand.json (About text, a citation, a copyright line) that the page loads
      # at startup. Keys are documented in services/hoast-player/brand.example.json.
      # Commented out for the same reason as the dashboard's copy above: create
      # custom/brand.json first, then uncomment both.
      #- ./custom/brand.json:/usr/share/nginx/html/brand.json:ro

  # ---------------------------------------------------------------------------
  # OWNER SRT ROUTE (optional). Push your OWN 16-channel stream from stock OBS
  # without ever enabling the keyless guest endpoint.
  #
  # WHY THIS IS A SECOND INSTANCE and not a flag on the one above: the public
  # srt-gateway parses hostile pre-auth bytes off the internet and deliberately
  # holds NO credentials. This instance holds RTMP_OWNER_KEY and, by default
  # (SRT_DIRECT=1 below), hands the stream straight to earshot's direct-DASH
  # listener; with SRT_DIRECT=0 it republishes into the token-authed `owner`
  # application instead. Either way it bypasses the guest
  # arbiter (no slot, no session cap, and it preempts a live guest). Keeping it
  # a separate service means the internet-facing guest gateway still holds no
  # credentials at all. Same image, same code, different mode.
  #
  # CHOOSING THE BIND. 127.0.0.1 for a local test. To stream from anywhere
  # else, 0.0.0.0 plus a UDP 8891 forward on your router, and point OBS at
  # srt://<your-public-address>:8891 with the same streamid and passphrase.
  # That is the whole recipe: an address, a port and your key.
  #
  # A key is enough because SRT's passphrase is the connection's AES key, not
  # a password checked after parsing - libsrt refuses the handshake before a
  # byte of payload is demuxed. It is also less exposure than the guest
  # endpoint on 8890, which takes no key at all. What it costs: the port is
  # scannable, GUEST_MAX_TEMP_C/GUEST_MAX_MBPS do not apply to owner sessions,
  # and whoever holds the passphrase can broadcast. Use a generated one.
  #
  # A VPN address (Tailscale/WireGuard) instead keeps the port off the
  # internet entirely, if you have one.
  #
  # Do NOT write a public IP this host does not itself hold: behind NAT that
  # address is your router's, and the bind appears to succeed while receiving
  # nothing. On a host with net.ipv4.ip_nonlocal_bind=1 (which
  # docs/ENDPOINTS.md recommends, for an unrelated boot race) it does not even
  # error. `ip -4 addr show scope global` lists what is
  # really here. When in doubt, 0.0.0.0.
  #
  # Prerequisites in .env: RTMP_OWNER_KEY (your own, `openssl rand -hex 24`)
  # and SRT_OWNER_PASSPHRASE (likewise). GUEST_ENABLED can stay 0 throughout.
  #
  # OBS then targets (Recording > Custom Output (FFmpeg), container mpegts,
  # four 4-channel tracks - the same recipe as docs/obs-windows.md section 5,
  # only the URL differs):
  #   srt://<private-ip>:8891?streamid=owner&passphrase=<SRT_OWNER_PASSPHRASE>&latency=2000000&pkt_size=1128
  #
  # Uncomment the whole block to use it.
  #
  # srt-gateway-owner:
  #   image: ambi-box-srt-gateway:local     # same image the base build produces
  #   build:
  #     context: ./services/srt-gateway
  #   environment:
  #     - SRT_ENABLED=1
  #     - SRT_MODE=owner
  #     # Direct-to-DASH, the default owner route: hand the probed stream
  #     # straight to earshot's listener instead of re-encoding it to 16-ch
  #     # AAC and republishing over RTMP. ~28-42 % of a core at 20 Mbps
  #     # against ~90-130 %, and one lossy audio generation fewer. Set
  #     # SRT_DIRECT=0 in .env for the legacy RTMP republish. Guests always
  #     # take the RTMP hop; that is where guest admission lives.
  #     - SRT_DIRECT=${SRT_DIRECT:-1}
  #     # Authenticates this gateway to telemetry's /gw/session/* routes; the
  #     # owner is a different container from srt-gateway and needs its own copy.
  #     - GUEST_GW_SECRET=${GUEST_GW_SECRET:-}
  #     - RTMP_OWNER_KEY=${RTMP_OWNER_KEY}
  #     - SRT_OWNER_PASSPHRASE=${SRT_OWNER_PASSPHRASE}   # MANDATORY in owner mode
  #     - SRT_LATENCY_MS=${SRT_LATENCY_MS:-2000}
  #     - HOME=/tmp
  #     - XDG_CACHE_HOME=/tmp
  #     - GST_REGISTRY=/tmp/gst-registry.bin
  #   ports:
  #     # Host port 8891 so it can coexist with the guest instance on 8890;
  #     # the container side stays 8890. Replace 100.64.0.1 with the address
  #     # you will reach it on - see CHOOSING THE BIND above.
  #     - "100.64.0.1:8891:8890/udp"
  #   read_only: true
  #   tmpfs:
  #     - /tmp
  #   cap_drop: [ALL]
  #   security_opt:
  #     - no-new-privileges:true
  #   init: true
  #   depends_on:
  #     rtmp-ingest:
  #       condition: service_healthy
  #   healthcheck:
  #     test: ["CMD", "python3", "-c",
  #            "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8091/health', timeout=2)"]
  #     interval: 10s
  #     timeout: 3s
  #     retries: 3
  #     start_period: 5s
  #   restart: unless-stopped
