# Copy to .env and adjust. All variables have working defaults in docker-compose.yml.

# ---------------------------------------------------------------------------
# Stream key - enforced at rtmp-ingest (the only public RTMP port).
# Publish either of:
#   rtmp://<host>:1935/live/<STREAM_KEY>
#   rtmp://<host>:1935/live/<any-name>?token=<STREAM_KEY>
# OBS ME: Server rtmp://<host>:1935/live  /  Stream Key: hoast_demo
# ---------------------------------------------------------------------------
STREAM_KEY=hoast_demo

# ---------------------------------------------------------------------------
# Public DASH manifest filename, served at /dash/<DASH_NAME>.mpd. Deliberately
# SEPARATE from STREAM_KEY: the publish name used to name this file, and any
# client on the public :1935 port chooses the publish name, so an interpolated
# name was an arbitrary-path write inside earshot. It is now fixed here and
# validated against [A-Za-z0-9_-]+ at earshot start. Must match the name the
# player page requests (services/hoast-player/index.html). Left at the default,
# STREAM_KEY can be rotated into a real secret without moving the manifest URL.
# ---------------------------------------------------------------------------
DASH_NAME=hoast_demo

# ---------------------------------------------------------------------------
# Video codec policy at earshot's transcode (audio is ALWAYS 16-ch Opus,
# mapping_family 255 - hardcoded in earshot; do not downmix).
#
# Default (set in docker-compose.yml): VP9 realtime => all-WebM DASH segments.
# NOTE: 2 s segments / -g 60 assume a 29.97/30 fps source (the demo content);
# use -g 50 for 25 fps. The rule is that segment duration must be an integer
# multiple of GOP duration: the muxer closes a segment at the first keyframe at
# or after the target, so -g 50 at 29.97 fps (a 1.668 s GOP) gives 3.34 s
# segments, i.e. two GOPs. Sub-multiple GOPs are valid but cost extra keyframes,
# so keep GOP equal to the segment duration for the live encode.
#
# suggestedPresentationDelay (>= 30 s, keeps players safely behind the live
# edge) is NOT settable by any ffmpeg flag - it is patched into the DASH muxer
# in services/earshot/src/Dockerfile (DASH_SPD_FLOOR build arg).
#
# VP9 must emit limited/tv colour range. The H.264 contribution is full-range
# (pc); full-range VP9 decodes fine as a plain file but breaks the dash.js/MSE
# player with PIPELINE_ERROR_DECODE on real GPUs, so convert it with the scale
# filter. The -c:v copy line below needs no conversion (it never re-encodes).
#FFMPEG_FLAGS=-window_size 100 -extra_window_size 30 -max_muxing_queue_size 1024 -vf scale=in_range=pc:out_range=tv -color_range tv -c:v libvpx-vp9 -deadline realtime -cpu-used 8 -row-mt 1 -b:v 4M -g 60 -keyint_min 60 -seg_duration 2 -dash_segment_type webm
#
# Low-CPU fallback (e.g. Raspberry Pi, or debugging): H.264 passthrough.
# Video segments become .mp4/.m4s while audio stays Opus/WebM - deviates from
# the all-WebM constraint, use only when VP9 realtime is not viable.
#
#FFMPEG_FLAGS=-window_size 100 -max_muxing_queue_size 1000 -c:v copy

# ---------------------------------------------------------------------------
# Delivery bitrate of the 16-channel Opus track.
#
# There is no separate variable for this. FFMPEG_FLAGS is interpolated after
# "-c:a libopus -mapping_family 255" in earshot's nginx.conf, so append -b:a to
# whichever FFMPEG_FLAGS line above you enable, e.g. "... -c:v copy -b:a 512k".
#
# Left unset, libopus targets 64 kb/s per uncoupled stream, so 16 discrete
# channels cost ~1024k. That is what this stack has always shipped; it is
# libopus's default, not a tuning result, so cite it as such. Lowering it is
# plausible (HOA channels above degree 0 carry far less energy than W) but
# untested; judge any change binaurally rendered, not on flat channels.
# Channel count and mapping_family 255 stay fixed.

# ---------------------------------------------------------------------------
# Demo content: ./content/demo.mp4  (gitignored; loop-source idles until present)
#
# The RTMP contribution leg requires H.264 video + 16-channel AAC with PCE
# headers in MP4/FLV - legacy RTMP cannot carry VP9/Opus. loop-source streams
# demo.mp4 with `-c copy` (zero CPU), so the file must be pre-encoded once.
#
# If the demo-master master recording already exists as H.264 + 16-ch AAC MP4,
# no transcode is needed - just copy it:
#   cp /path/to/demo-master-h264-aac16.mp4 content/demo.mp4
#
# Otherwise prepare it once from any 16-ch master (WebM/MOV/WAV+video) using
# the earshot image's ffmpeg, which writes correct PCE headers
# (build it first: docker compose build earshot):
#
#   docker run --rm -v "$PWD/content:/content" --entrypoint ffmpeg \
#     hoa360-earshot:local \
#     -i /content/demo-master-master.webm \
#     -c:v libx264 -preset veryfast -b:v 6M -pix_fmt yuv420p -g 50 \
#     -af "channelmap=channel_layout=hexadecagonal" \
#     -c:a aac -ac 16 -b:a 2048k \
#     -movflags +faststart \
#     /content/demo.mp4
#
# Keep -g (GOP) equal to segment_duration * fps, or an exact sub-multiple of it;
# segment duration must be an integer multiple of GOP duration. Equality is the
# preferred default, since extra keyframes cost bitrate. Note the -g 50 above is
# the 25 fps value: the 29.97 fps master needs -g 60. Under -c:v copy there is
# no -g at earshot, so this contribution GOP is the one that governs
# segmentation. 16-ch order must be ACN/SN3D (AmbiX) end to end.
