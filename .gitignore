output/*
!output/.gitkeep
# earshot wipes ./output on every start; ./scratch is the sibling that survives
scratch/*
!scratch/.gitkeep
content/*.mp4
content/*.mov
content/*.wav
content/*.webm
content/**/*.mp4
content/**/*.mov
content/**/*.wav
content/**/*.webm
!content/.gitkeep
.env
.env.*
!.env.example
# deployment-specific, per host (see docker-compose.override.yml.example)
docker-compose.override.yml
docker-compose.override.yml.*
!docker-compose.override.yml.example
custom/
node_modules/
# generated by scripts/package-dash-variants.sh
lip-sync-test/dash_*/
lip-sync-test/dist/
lip-sync-test/irs/
.DS_Store

# python bytecode (telemetry collector)
__pycache__/
*.pyc

# local-only working notes (audits, scratch analysis); not part of the published repo
docs/local/

# generated VOD packaging (masters are content/**/*.webm above; these dirs are derived)
content/vod/dash/
content/vod/ladder/
content/vod/ladder-*/
# caption sidecars ship as release assets alongside their clip, like the masters
content/**/*.vtt
# the orientation card is regenerated by scripts/make-orientation-card.py
content/**/*.png

# Draft paper material; kept out of the public repo permanently
# (findings will be cited via the published papers instead)
docs/PAPER-NOTES.md

# generated by docs/architecture/build.sh with the local browser path
docs/architecture/puppeteer-config.json
docs/PLAN.md

# history backups: never commit these, they carry pre-rewrite history
*.bundle

# measurement scratch: excerpts, per-condition encodes, binaural renders.
# Regenerable from the corpus + harness; the deliverables (results.tsv,
# bamq.tsv, the figures) are committed, these are not. opus-compression-test's
# equivalent work dir was left untracked with no gitignore entry and was later
# lost to manual cleanup, which is why the AAC study's item mapping had to be
# recovered from session transcripts - explicit entries this time.
aac-bitrate-test/work/
aac-bitrate-test/binaural/
aac-bitrate-test/run.log
opus-compression-test/work/
