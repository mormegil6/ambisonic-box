daemon off;
# notice, not info: nginx-rtmp logs the publish event ("publish: name=... args=
# token=...") at info, which would write the ?token= credential to stdout on
# every publish. notice keeps warnings/errors; raise back to info temporarily to
# debug RTMP connect/publish flow.
error_log /dev/stdout notice;
pid /run/nginx/nginx.pid;

load_module /usr/lib/nginx/modules/ngx_rtmp_module.so;

events {
    worker_connections 1024;
}

rtmp {
    # nginx-rtmp keeps its OWN access log, separate from the http block's, and
    # it defaults to a file under nginx's prefix - which a read-only rootfs
    # makes unopenable, killing startup outright. Off rather than redirected to
    # stdout: the rtmp `combined` format logs $args, and $args is where the
    # publish token rides, so stdout would write the credential into docker logs
    # on every publish - the same leak the `error_log notice` line above avoids.
    # Nothing consumes it either way; telemetry reads /stat and the HTTP
    # callbacks, never this container's log stream.
    access_log off;

    server {
        listen 1935;
        chunk_size 4000;
        notify_method get;
        # 4K H.264 keyframes routinely exceed nginx-rtmp's 1M default
        # (demo.mp4 peaks at ~1.2M); "too big message" kills the publisher
        max_message 10M;

        application live {
            live on;
            # auth against the local http block below; nginx-rtmp passes
            # ?call=publish&name=<stream>&token=<arg from the publish URL>...
            on_publish http://127.0.0.1:8080/auth;
            # tell telemetry when a /live publisher leaves, so an external
            # owner's departure clears the owner-live latch and hands the
            # slot back to the demo loop's normal on-demand rule
            on_publish_done http://127.0.0.1:8080/live_done;
            # relay the authenticated stream to the transcoder (internal network only)
            push rtmp://earshot:1935/live;
        }

        # Guest test endpoint (see guest-rtmp.conf). The entrypoint writes the
        # real application here when GUEST_ENABLED=1 and an empty file
        # otherwise, so a default deployment carries no keyless application.
        include /run/nginx/guest-rtmp.conf;
    }
}

http {

    # FAILED PUBLISH AUTH, and only that, gets its own line. Without this a
    # brute-force attempt against the stream key leaves no trace at all: /auth
    # runs with access_log off, deliberately, because the credential arrives as
    # ?token= and would otherwise be written to docker logs on every successful
    # publish. So the rule is not "log /auth" but "log only the rejections, and
    # only the fields that are not the secret".
    #
    # $status is evaluated at log time, so mapping it here picks out rejections
    # without needing a second location block.
    map $status $auth_denied {
        401     1;
        default 0;
    }

    # $arg_addr is the PUBLISHER's address, handed over by nginx-rtmp in the
    # on_publish callback. $remote_addr would be worse than useless: the callback
    # is nginx-rtmp calling its own HTTP side, so it is always 127.0.0.1, and a
    # fail2ban jail keyed on it would ban loopback.
    #
    # Deliberately absent: $args, $arg_token, $arg_name. A rejected guess is the
    # attacker's string rather than the key, but a fat-fingered REAL key would
    # land here too, so none of them are recorded.
    log_format rtmpauth 'rtmp-auth-denied client=$arg_addr app=$arg_app';

    access_log /dev/stdout;

    # Temp paths must be stated, not defaulted: the container runs a read-only
    # rootfs, so nginx's compile-time default under /var/lib/nginx is not
    # writable and startup dies with `mkdir() ".../client_body" failed
    # (13: Permission denied)`. /run/nginx is the entrypoint's tmpfs. Everything
    # under it stays ROOT-owned on purpose: the master creates these directories
    # itself and chowns them to the worker user (CAP_CHOWN is granted for
    # exactly that), whereas pre-chowning them to `nginx` would lock the master
    # out, since CAP_DAC_OVERRIDE is dropped and root then loses its usual right
    # to write into directories it does not own.
    client_body_temp_path /run/nginx/tmp/client_body;
    proxy_temp_path       /run/nginx/tmp/proxy;
    fastcgi_temp_path     /run/nginx/tmp/fastcgi;
    uwsgi_temp_path       /run/nginx/tmp/uwsgi;
    scgi_temp_path        /run/nginx/tmp/scgi;

    server {
        listen 8080;

        # Two separate secrets gate this app, because the two publishers have
        # different threat models. RTMP_OWNER_KEY authenticates a publish that
        # arrives over the PUBLIC :1935 port (a real OBS/SRT-relay owner push)
        # and is checked by NAME (OBS's plain Stream Key field) or by ?token=
        # (the srt-gateway owner relay, internal but sharing the same secret
        # as its RTMP counterpart on purpose). LIVE_APP_KEY only ever arrives
        # as ?token= from loop-source over the docker-internal network - it
        # never faces the public internet, so it stays a low-stakes internal
        # handshake rather than a second public-facing credential:
        #   rtmp://<host>:1935/live/${RTMP_OWNER_KEY}
        #   rtmp://<host>:1935/live/<anything>?token=${RTMP_OWNER_KEY}
        #   rtmp://<host>:1935/live/<anything>?token=${LIVE_APP_KEY}   (loop-source only)
        location = /auth {
            # The publish credential arrives here as ?token= (or the stream
            # name); keep it out of the access log so the key is not written to
            # stdout/docker logs on every publish.
            # There is deliberately NO `access_log off;` here. nginx treats off
            # as cancelling EVERY access_log directive on the level, including
            # ones that follow it, so pairing the two silently logged nothing -
            # which is exactly how the first version of this failed.
            #
            # This one directive replaces the inherited `combined` format, which
            # must never apply here: it logs $request, and the credential arrives
            # as ?token=, so the key would reach docker logs on every successful
            # publish. rtmpauth carries no credential, and if= means only
            # rejections are written at all.
            access_log /dev/stdout rtmpauth if=$auth_denied;
            if ($arg_name = '${RTMP_OWNER_KEY}') {
                return 418;
            }
            if ($arg_token = '${RTMP_OWNER_KEY}') {
                return 418;
            }
            if ($arg_token = '${LIVE_APP_KEY}') {
                return 418;
            }
            return 401;
        }

        # 418 carries no meaning here; it is an internal marker so a matched
        # key can run one more step - telling telemetry to preempt any
        # in-progress guest session - before answering nginx-rtmp, without
        # nesting proxy_pass inside the `if` blocks above.
        error_page 418 = @owner_authed;
        location @owner_authed {
            # Best-effort only: the owner's publish must succeed whether or
            # not telemetry is running (it can be stopped, restarting, or
            # simply absent in a cut-down deployment), so any failure here is
            # masked back to success.
            access_log off;
            resolver 127.0.0.11 valid=5s;
            set $arbiter http://telemetry:8090;
            # the name rides along so telemetry can tell the demo loop's own
            # publish (name = the stream key) apart from an EXTERNAL owner;
            # only the name, never the token, so nothing secret leaves here
            proxy_pass $arbiter/rtmp/live/notify?name=$arg_name;
            proxy_read_timeout 3s;
            proxy_intercept_errors on;
            error_page 500 502 503 504 = @owner_authed_fallback;
        }
        location @owner_authed_fallback {
            return 201;
        }

        # on_publish_done for the live app, forwarded best-effort the same way
        # as @owner_authed (nginx-rtmp ignores done-callback status anyway)
        location = /live_done {
            access_log off;
            resolver 127.0.0.11 valid=5s;
            set $arbiter http://telemetry:8090;
            proxy_pass $arbiter/rtmp/live/done?name=$arg_name;
            proxy_read_timeout 3s;
            proxy_intercept_errors on;
            error_page 500 502 503 504 = @owner_authed_fallback;
        }

        location = /health {
            return 200 'OK';
        }

        location = /stat {
            rtmp_stat all;
        }

        # Guest arbiter proxy locations (see guest-http.conf); empty include
        # unless GUEST_ENABLED=1, matching the rtmp half above.
        include /run/nginx/guest-http.conf;
    }
}
