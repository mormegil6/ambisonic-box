daemon off;
# notice, not info: nginx-rtmp logs the publish event ("publish: name=... args=
# token=...") at info, which would write the ?token= credential to stdout on
# every publish. notice keeps warnings/errors; raise back to info temporarily to
# debug RTMP connect/publish flow.
error_log /dev/stdout notice;
pid /run/nginx/nginx.pid;

load_module /usr/lib/nginx/modules/ngx_rtmp_module.so;

events {
    worker_connections 1024;
}

rtmp {
    server {
        listen 1935;
        chunk_size 4000;
        notify_method get;
        # 4K H.264 keyframes routinely exceed nginx-rtmp's 1M default
        # (demo.mp4 peaks at ~1.2M); "too big message" kills the publisher
        max_message 10M;

        application live {
            live on;
            # auth against the local http block below; nginx-rtmp passes
            # ?call=publish&name=<stream>&token=<arg from the publish URL>...
            on_publish http://127.0.0.1:8080/auth;
            # relay the authenticated stream to the transcoder (internal network only)
            push rtmp://earshot:1935/live;
        }

        # Guest test endpoint (see guest-rtmp.conf). The entrypoint writes the
        # real application here when GUEST_ENABLED=1 and an empty file
        # otherwise, so a default deployment carries no keyless application.
        include /etc/nginx/guest-rtmp.conf;
    }
}

http {
    access_log /dev/stdout;

    server {
        listen 8080;

        # Accept a publish when either the stream name or a ?token= query arg
        # matches the configured stream key:
        #   rtmp://<host>:1935/live/${STREAM_KEY}
        #   rtmp://<host>:1935/live/<anything>?token=${STREAM_KEY}
        location = /auth {
            # The publish credential arrives here as ?token= (or the stream
            # name); keep it out of the access log so the key is not written to
            # stdout/docker logs on every publish.
            access_log off;
            if ($arg_name = '${STREAM_KEY}') {
                return 201;
            }
            if ($arg_token = '${STREAM_KEY}') {
                return 201;
            }
            return 401;
        }

        location = /health {
            return 200 'OK';
        }

        location = /stat {
            rtmp_stat all;
        }

        # Guest arbiter proxy locations (see guest-http.conf); empty include
        # unless GUEST_ENABLED=1, matching the rtmp half above.
        include /etc/nginx/guest-http.conf;
    }
}
